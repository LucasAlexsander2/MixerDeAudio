<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MixerDeAudio.Flyout.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MixerDeAudio.ViewModels"
    AutomationProperties.AutomationId="SettingsPage" AutomationProperties.Name="Configurações"
    AutomationProperties.AccessibilityView="Content">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topo: voltar e título -->
        <Grid ColumnSpacing="8" Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" AutomationProperties.AutomationId="SettingsBack" AutomationProperties.Name="Voltar"
                    ToolTipService.ToolTip="Voltar" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1" Text="Configurações" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel Spacing="20">
                <!-- Novidades da versão (Fase 11, D8): uma vez depois de atualizar -->
                <Border AutomationProperties.AutomationId="NotesCard" AutomationProperties.Name="{x:Bind Model.NotesTitle}"
                        Visibility="{x:Bind Model.NotesVisibility}" Padding="12" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock AutomationProperties.AutomationId="NotesTitle" Text="{x:Bind Model.NotesTitle}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="NotesList" AutomationProperties.AutomationId="NotesList" AutomationProperties.AccessibilityView="Content">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NoteItemView">
                                    <Grid ColumnSpacing="10" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Saídas favoritas -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Saídas favoritas (até 3)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="NoDevicesText" Text="Nenhuma saída de áudio." Opacity="0.8" Visibility="Collapsed" />
                    <ItemsControl x:Name="FavoriteList" AutomationProperties.AutomationId="FavoriteList"
                                  AutomationProperties.Name="Saídas favoritas" AutomationProperties.AccessibilityView="Content">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteItemViewModel">
                                <CheckBox AutomationProperties.AutomationId="FavoriteCheck"
                                          AutomationProperties.Name="{x:Bind Label}"
                                          ToolTipService.ToolTip="{x:Bind FullName}"
                                          Content="{x:Bind Label}"
                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                          MinHeight="32" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Com favoritas, só elas aparecem nos botões (mais a saída ativa). Sem nenhuma, aparecem todas."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                </StackPanel>

                <!-- Tema -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Tema" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton GroupName="Tema" Content="Automático" MinWidth="0"
                                     AutomationProperties.AutomationId="ThemeAuto" AutomationProperties.Name="Automático"
                                     IsChecked="{x:Bind Model.IsThemeAuto, Mode=TwoWay}" />
                        <RadioButton GroupName="Tema" Content="Claro" MinWidth="0"
                                     AutomationProperties.AutomationId="ThemeLight" AutomationProperties.Name="Claro"
                                     IsChecked="{x:Bind Model.IsThemeLight, Mode=TwoWay}" />
                        <RadioButton GroupName="Tema" Content="Escuro" MinWidth="0"
                                     AutomationProperties.AutomationId="ThemeDark" AutomationProperties.Name="Escuro"
                                     IsChecked="{x:Bind Model.IsThemeDark, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- Iniciar com o Windows -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Iniciar com o Windows" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch AutomationProperties.AutomationId="StartupSwitch" AutomationProperties.Name="Iniciar com o Windows"
                                  OnContent="Ligado" OffContent="Desligado"
                                  IsOn="{x:Bind Model.StartupEnabled, Mode=TwoWay}" />
                </StackPanel>

                <!-- Atualização (Fase 11, D6) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Atualização" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock AutomationProperties.AutomationId="UpdateVersion" Text="{x:Bind Model.UpdateVersionText}" />
                    <TextBlock AutomationProperties.AutomationId="UpdateStatus" Text="{x:Bind Model.UpdateStatusText, Mode=OneWay}"
                               TextWrapping="Wrap" Opacity="0.8" />
                    <ProgressBar AutomationProperties.AutomationId="UpdateProgress" AutomationProperties.Name="Progresso do download"
                                 Minimum="0" Maximum="100" Value="{x:Bind Model.ProgressValue, Mode=OneWay}"
                                 Visibility="{x:Bind Model.ProgressVisibility, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="UpdateCheck" AutomationProperties.Name="Procurar agora"
                                Content="Procurar agora" Click="OnUpdateCheckClick" IsEnabled="{x:Bind Model.CanCheckNow, Mode=OneWay}"
                                Visibility="{x:Bind Model.CheckVisibility, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="UpdateDownload" AutomationProperties.Name="Atualizar"
                                Content="Atualizar" Click="OnUpdateDownloadClick" Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind Model.DownloadVisibility, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="UpdateRestart" AutomationProperties.Name="Reiniciar para atualizar"
                                Content="Reiniciar para atualizar" Click="OnUpdateRestartClick" Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind Model.RestartVisibility, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.AutomationId="UpdateAuto" AutomationProperties.Name="Procurar atualizações automaticamente"
                                  Header="Procurar atualizações automaticamente" OnContent="Ligado" OffContent="Desligado"
                                  IsOn="{x:Bind Model.AutoUpdate, Mode=TwoWay}" />
                </StackPanel>

                <!-- Controle pelo celular (Fase 6, D17) -->
                <StackPanel Spacing="4" Visibility="{x:Bind Model.RemoteAvailableVisibility}">
                    <TextBlock Text="Controle pelo celular" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch AutomationProperties.AutomationId="RemoteSwitch" AutomationProperties.Name="Controle pelo celular"
                                  OnContent="Ligado" OffContent="Desligado"
                                  IsOn="{x:Bind Model.RemoteEnabled, Mode=TwoWay}" />
                    <TextBlock AutomationProperties.AutomationId="RemoteFirewallHint"
                               Text="Se o Windows perguntar, permita o acesso em redes privadas."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                    <StackPanel Spacing="8" Visibility="{x:Bind Model.RemoteVisibility, Mode=OneWay}">
                        <TextBlock Text="No celular, no mesmo Wi-Fi, leia o QR code ou abra o endereço e digite o código. O PC vai perguntar se permite o celular."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        <TextBlock AutomationProperties.AutomationId="RemoteAddress"
                                   Text="{x:Bind Model.RemoteAddress, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock AutomationProperties.AutomationId="RemoteWarning"
                                   Text="{x:Bind Model.RemoteWarning, Mode=OneWay}" Visibility="{x:Bind Model.RemoteWarningVisibility, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock AutomationProperties.AutomationId="RemoteAddressHint"
                                   Text="Para o endereço não mudar, reserve o IP deste PC no roteador (DHCP). No iPhone, o atalho da Tela de Início precisa ser pareado uma vez."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        <TextBlock AutomationProperties.AutomationId="RemoteCode"
                                   Text="{x:Bind Model.RemoteCode, Mode=OneWay}" IsTextSelectionEnabled="True"
                                   FontSize="28" FontWeight="SemiBold" CharacterSpacing="200" />
                        <Image AutomationProperties.AutomationId="RemoteQr" AutomationProperties.Name="QR code para conectar o celular"
                               Source="{x:Bind Model.RemoteQr, Mode=OneWay}" Width="160" Height="160" HorizontalAlignment="Left" Stretch="Uniform" />
                        <TextBlock AutomationProperties.AutomationId="RemoteCount"
                                   Text="{x:Bind Model.RemoteCount, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="RemoteDisconnect" AutomationProperties.Name="Desconectar"
                                Content="Desconectar" Click="OnDisconnectClick" Visibility="{x:Bind Model.RemoteDisconnectVisibility, Mode=OneWay}" />
                        <Button AutomationProperties.AutomationId="RemoteNewCode" AutomationProperties.Name="Gerar novo código"
                                Content="Gerar novo código" Click="OnNewCodeClick" />
                        <TextBlock Text="Gerar um novo código desconecta todos os celulares. A conexão é só pela rede de casa, sem criptografia."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />

                        <!-- Ferramentas do PC (Fase 9, D2) -->
                        <TextBlock Text="Ferramentas do PC" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="Ligue só o que for usar: o celular conectado usa o PC como se estivesse no teclado."
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolPower" AutomationProperties.Name="Desligar, reiniciar, suspender e bloquear"
                                      Header="Energia" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolPower, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolDisplay" AutomationProperties.Name="Projeção e telas"
                                      Header="Monitores" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolDisplay, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolInput" AutomationProperties.Name="Mouse, teclado e apresentação"
                                      Header="Mouse e teclado" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolInput, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolScreen" AutomationProperties.Name="Ver a tela"
                                      Header="Ver a tela" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolScreen, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolWindows" AutomationProperties.Name="Janelas abertas"
                                      Header="Janelas" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolWindows, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolShortcuts" AutomationProperties.Name="Atalhos favoritos"
                                      Header="Atalhos" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolShortcuts, Mode=TwoWay}" />
                        <Button AutomationProperties.AutomationId="ShortcutsFolder" AutomationProperties.Name="Abrir pasta de atalhos"
                                Content="Abrir pasta de atalhos" Click="OnShortcutsFolderClick" Visibility="{x:Bind Model.ShortcutsFolderVisibility, Mode=OneWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolTransfer" AutomationProperties.Name="Área de transferência e arquivos"
                                      Header="Área de transferência e arquivos" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolTransfer, Mode=TwoWay}" />
                        <ToggleSwitch AutomationProperties.AutomationId="ToolInfo" AutomationProperties.Name="Estado do PC e timer de sono"
                                      Header="Estado do PC e timer de sono" OnContent="Ligado" OffContent="Desligado" IsOn="{x:Bind Model.ToolInfo, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock AutomationProperties.AutomationId="AppVersion" Text="{x:Bind Model.VersionLabel}"
                           Opacity="0.6" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
