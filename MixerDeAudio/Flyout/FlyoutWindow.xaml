<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MixerDeAudio.Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MixerDeAudio.ViewModels">

    <Grid x:Name="Root" AutomationProperties.AutomationId="FlyoutRoot" AutomationProperties.Name="Mixer de Áudio"
          AutomationProperties.AccessibilityView="Content" Padding="20,16,12,12" IsTabStop="True" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- D14: fileira de botões das saídas (rola na horizontal só se não couber) -->
        <Grid Grid.Row="0" MinHeight="64">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Padding="0,0,0,8">
                <ItemsControl x:Name="DeviceList" AutomationProperties.AutomationId="DeviceList"
                              AutomationProperties.Name="Saídas de áudio" AutomationProperties.AccessibilityView="Content">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceButtonViewModel">
                            <ToggleButton AutomationProperties.AutomationId="DeviceButton"
                                          AutomationProperties.Name="{x:Bind FullName, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind FullName, Mode=OneWay}"
                                          IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                          Click="{x:Bind OnClick}"
                                          Width="76" Height="56" Padding="4,4,4,4">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" />
                                    <TextBlock Text="{x:Bind ShortName, Mode=OneWay}" FontSize="12" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="66" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="NoDeviceText" AutomationProperties.AutomationId="NoDeviceText"
                       Text="Nenhuma saída de áudio" Opacity="0.8" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <!-- D14: volume geral (mesmas medidas da linha de um app) -->
        <ItemsControl x:Name="MasterHost" Grid.Row="1" Margin="0,0,18,0" AutomationProperties.AccessibilityView="Content">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MasterVolumeViewModel">
                    <Grid Height="40" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton AutomationProperties.AutomationId="MasterMute"
                                      AutomationProperties.Name="{x:Bind MuteName, Mode=OneWay}"
                                      IsChecked="{x:Bind Muted, Mode=TwoWay}" IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                      Width="32" Height="28" Padding="0" VerticalAlignment="Center"
                                      Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="{x:Bind MuteGlyph, Mode=OneWay}" FontSize="16" />
                        </ToggleButton>
                        <Slider Grid.Column="1" AutomationProperties.AutomationId="MasterVolume" IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                AutomationProperties.Name="Volume geral"
                                Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                                Value="{x:Bind Volume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="MasterValue"
                                   Text="{x:Bind ValueText, Mode=OneWay}" VerticalAlignment="Center"
                                   TextAlignment="Right" Opacity="0.8" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Rectangle Grid.Row="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,18,0" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
            <Grid>
                <ItemsControl x:Name="SessionList" AutomationProperties.AutomationId="SessionList"
                              AutomationProperties.Name="Apps com som" AutomationProperties.AccessibilityView="Content">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRowViewModel">
                            <Grid AutomationProperties.AutomationId="SessionRow"
                                  AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                  AutomationProperties.AccessibilityView="Content"
                                  Height="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="24" Height="24" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                           Width="24" Height="24" />
                                    <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="20"
                                              Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                </Grid>

                                <Grid Grid.Column="1" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Fase 4, D9: nome (cortado com reticências) e, à direita, um botão por saída -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" Margin="0,4,0,0" VerticalAlignment="Top" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Routes}"
                                                      Visibility="{x:Bind RouteVisibility, Mode=OneWay}"
                                                      VerticalAlignment="Top" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RouteButtonViewModel">
                                                    <ToggleButton AutomationProperties.AutomationId="RouteButton"
                                                                  AutomationProperties.Name="{x:Bind Name}"
                                                                  ToolTipService.ToolTip="{x:Bind Name}"
                                                                  IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                                  Click="{x:Bind OnClick}"
                                                                  Width="28" Height="24" Padding="0">
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton AutomationProperties.AutomationId="SessionMute"
                                                      AutomationProperties.Name="{x:Bind MuteName, Mode=OneWay}"
                                                      IsChecked="{x:Bind Muted, Mode=TwoWay}"
                                                      Width="32" Height="28" Padding="0" VerticalAlignment="Center"
                                                      Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="{x:Bind MuteGlyph, Mode=OneWay}" FontSize="16" />
                                        </ToggleButton>
                                        <Slider Grid.Column="1" AutomationProperties.AutomationId="SessionVolume"
                                                AutomationProperties.Name="{x:Bind VolumeName, Mode=OneWay}"
                                                Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                IsThumbToolTipEnabled="False" VerticalAlignment="Center"
                                                Value="{x:Bind Volume, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="SessionValue"
                                                   Text="{x:Bind ValueText, Mode=OneWay}" VerticalAlignment="Center"
                                                   TextAlignment="Right" Opacity="0.8" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" AutomationProperties.AutomationId="EmptyText"
                           Text="Nenhum app com som agora." Opacity="0.8" Margin="0,8,0,0" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
