<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MixerDeAudio.Flyout.PcPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Janelinha de pergunta do PC (Fase 16, D9): pequena, por cima de tudo, aparece sem ativar (não rouba o foco). -->
    <Grid x:Name="Root" AutomationProperties.AutomationId="PcPromptRoot" AutomationProperties.Name="Pergunta da Controladora PC"
          AutomationProperties.AccessibilityView="Content" Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" AutomationProperties.AutomationId="PcPromptTitle" Style="{ThemeResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Grid.Row="1" AutomationProperties.AutomationId="PcPromptText" TextWrapping="Wrap" Opacity="0.8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="PrimaryButton" AutomationProperties.AutomationId="PcPromptPrimary" Style="{ThemeResource AccentButtonStyle}"
                    Click="OnPrimaryClick" MinWidth="96" />
            <Button x:Name="SecondaryButton" AutomationProperties.AutomationId="PcPromptSecondary"
                    Click="OnSecondaryClick" MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
